# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from ENV or a
# password manager. DO NOT ENTER RAW CREDENTIALS HERE. This file must remain safe for git.

# GHCR token for the initial sergii/tp-installer-3f3 image.
# Export a token that can push packages before running Kamal.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Use a URL-safe password because it is embedded into PostgreSQL connection URLs below.
# Recommended one-time generation: openssl rand -hex 32
PROJECT_DB_PASSWORD=$PROJECT_DB_PASSWORD

DATABASE_URL="postgresql://teplotec:${PROJECT_DB_PASSWORD}@teplotec-project-postgres:5432/teplotec_project"
CACHE_DATABASE_URL="postgresql://teplotec:${PROJECT_DB_PASSWORD}@teplotec-project-postgres:5432/teplotec_project_cache"
QUEUE_DATABASE_URL="postgresql://teplotec:${PROJECT_DB_PASSWORD}@teplotec-project-postgres:5432/teplotec_project_queue"
CABLE_DATABASE_URL="postgresql://teplotec:${PROJECT_DB_PASSWORD}@teplotec-project-postgres:5432/teplotec_project_cable"

# Never check config/master.key into git.
RAILS_MASTER_KEY=$(cat config/master.key)
